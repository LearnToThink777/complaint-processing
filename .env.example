# ── LLM 모델 버전은 코드에 고정돼 있습니다(개발자 공통). 여기서 바꾸지 마세요. ──
#   - provider="mlapi"(기본): openai/gpt-5-nano   (llm.py MlapiLLM 기본값)
#   - provider="mlapi-mini" : openai/gpt-5-mini   (llm.py:471)
#   버전을 바꾸려면 llm.py 를 고쳐 커밋하세요(모두 같은 버전을 쓰도록). 아래 값은
#   '내 키·내 엔드포인트'일 뿐이며 개발자마다 자기 것을 채웁니다(커밋되지 않음).
#
# 부트캠프 제공 OpenAI 호환 프록시(mlapi.run). mlapi.run은 엔드포인트(UUID)마다
# 모델이 하나로 고정돼 있어 URL을 모델별로 나눠 둔다(NANO=nano, BASE=mini).
MLAPI_API_KEY=
MLAPI_NANO_BASE_URL=
MLAPI_BASE_URL=

# Groq API 키 (무료 티어). https://console.groq.com 에서 발급.
# 하루 14,400회로 반복 개발·테스트에 적합. provider="groq"로 전환 가능.
# 판정용 GroqLLM 과 검증용 GroqSemanticVerifier가 이 키를 쓴다.
GROQ_API_KEY=

# Google Gemini API 키 (무료 티어). https://aistudio.google.com 에서 발급.
# 임베딩(gemini-embedding-001)은 이 키로만 가능 — Groq/mlapi는 임베딩을 제공하지 않는다.
# 판정용 GeminiLLM 과 검증용 GeminiSemanticVerifier도 이 키로 대체 가능(provider="gemini").
GEMINI_API_KEY=

# 국가법령정보 공동활용 Open API(law.go.kr). https://open.law.go.kr 에서 신청.
# OC = 신청 시 등록한 이메일의 '@' 앞부분(이메일 전체 아님). build_index.py --live-law
# 가 이 값으로 lawSearch.do/lawService.do 를 호출해 조문 원문을 가져온다.
LAWGOKR_OC=

# 이 파일을 .env 로 복사하고 값을 채우세요. .env 는 .gitignore 로 커밋되지 않습니다.
